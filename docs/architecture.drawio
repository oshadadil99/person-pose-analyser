<mxfile host="app.diagrams.net">
  <diagram name="Architecture" id="arch">
    <mxGraphModel dx="1200" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1000" pageHeight="1100" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />

        <!-- main pipeline (left column) -->
        <mxCell id="video" value="&lt;b&gt;Video&lt;/b&gt;&lt;br&gt;fixed bedroom camera" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;" vertex="1" parent="1">
          <mxGeometry x="40" y="20" width="260" height="60" as="geometry" />
        </mxCell>
        <mxCell id="sampler" value="&lt;b&gt;Frame sampler&lt;/b&gt;&lt;br&gt;~5 fps, exact timestamps" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1">
          <mxGeometry x="40" y="110" width="260" height="60" as="geometry" />
        </mxCell>
        <mxCell id="pose" value="&lt;b&gt;YOLO11-pose + ByteTrack&lt;/b&gt;&lt;br&gt;boxes, 17 keypoints, track IDs" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1">
          <mxGeometry x="40" y="200" width="260" height="60" as="geometry" />
        </mxCell>
        <mxCell id="patient" value="&lt;b&gt;Patient selection&lt;/b&gt;&lt;br&gt;track nearest the bed, re-link lost IDs" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1">
          <mxGeometry x="40" y="290" width="260" height="60" as="geometry" />
        </mxCell>
        <mxCell id="rules" value="&lt;b&gt;Features + frame rules&lt;/b&gt;&lt;br&gt;angles, bed / seat position, speed&lt;br&gt;→ state + confidence per frame" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="1">
          <mxGeometry x="40" y="380" width="260" height="70" as="geometry" />
        </mxCell>
        <mxCell id="sm" value="&lt;b&gt;State machine&lt;/b&gt;&lt;br&gt;weighted vote, min dwell, back-dating&lt;br&gt;→ timeline segments" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="1">
          <mxGeometry x="40" y="480" width="260" height="70" as="geometry" />
        </mxCell>
        <mxCell id="events" value="&lt;b&gt;Bed events&lt;/b&gt;&lt;br&gt;BED_EXIT / RETURN_TO_BED" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="1">
          <mxGeometry x="40" y="580" width="260" height="60" as="geometry" />
        </mxCell>
        <mxCell id="triggers" value="&lt;b&gt;Triggers&lt;/b&gt;&lt;br&gt;possible fall, low-confidence event,&lt;br&gt;unknown stretch, 2+ people" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;" vertex="1" parent="1">
          <mxGeometry x="40" y="670" width="260" height="70" as="geometry" />
        </mxCell>
        <mxCell id="agent" value="&lt;b&gt;Investigator agent&lt;/b&gt;&lt;br&gt;Reason → Act → Observe&lt;br&gt;max 4 tool calls" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;" vertex="1" parent="1">
          <mxGeometry x="40" y="770" width="260" height="70" as="geometry" />
        </mxCell>
        <mxCell id="alerts" value="&lt;b&gt;Alert rules&lt;/b&gt;&lt;br&gt;NORMAL / MONITOR / ALERT&lt;br&gt;(deterministic, never the LLM)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;" vertex="1" parent="1">
          <mxGeometry x="40" y="870" width="260" height="70" as="geometry" />
        </mxCell>
        <mxCell id="outputs" value="&lt;b&gt;Outputs&lt;/b&gt;&lt;br&gt;timeline, summary, events,&lt;br&gt;decisions, agent traces" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;" vertex="1" parent="1">
          <mxGeometry x="40" y="970" width="260" height="70" as="geometry" />
        </mxCell>

        <!-- side boxes -->
        <mxCell id="scene" value="&lt;b&gt;Scene&lt;/b&gt;&lt;br&gt;camera-move check (every 2 s)&lt;br&gt;YOLO11-seg: bed + seat outlines&lt;br&gt;per camera position" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1">
          <mxGeometry x="380" y="190" width="260" height="80" as="geometry" />
        </mxCell>
        <mxCell id="tools" value="&lt;b&gt;Tools&lt;/b&gt;&lt;br&gt;look_back, look_forward,&lt;br&gt;check_bed_overlap, get_pose_summary,&lt;br&gt;count_people, ask_vlm" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;" vertex="1" parent="1">
          <mxGeometry x="380" y="765" width="260" height="80" as="geometry" />
        </mxCell>
        <mxCell id="gemini" value="&lt;b&gt;Gemini (VLM)&lt;/b&gt;&lt;br&gt;looks at frames / picks tools&lt;br&gt;cached, retried, fallback model" style="shape=cylinder3;whiteSpace=wrap;html=1;boundedLbl=1;size=12;fillColor=#e1d5e7;strokeColor=#9673a6;" vertex="1" parent="1">
          <mxGeometry x="700" y="760" width="230" height="90" as="geometry" />
        </mxCell>
        <mxCell id="cache" value="cached: perception.jsonl, scene.json&lt;br&gt;(everything below reruns in seconds)" style="text;html=1;align=left;verticalAlign=middle;fontSize=11;fontColor=#666666;" vertex="1" parent="1">
          <mxGeometry x="380" y="290" width="280" height="40" as="geometry" />
        </mxCell>

        <!-- edges -->
        <mxCell id="e1" style="endArrow=classic;html=1;" edge="1" parent="1" source="video" target="sampler"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="e2" style="endArrow=classic;html=1;" edge="1" parent="1" source="sampler" target="pose"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="e3" style="endArrow=classic;html=1;" edge="1" parent="1" source="pose" target="patient"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="e4" style="endArrow=classic;html=1;" edge="1" parent="1" source="patient" target="rules"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="e5" style="endArrow=classic;html=1;" edge="1" parent="1" source="rules" target="sm"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="e6" style="endArrow=classic;html=1;" edge="1" parent="1" source="sm" target="events"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="e7" style="endArrow=classic;html=1;" edge="1" parent="1" source="events" target="triggers"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="e8" style="endArrow=classic;html=1;" edge="1" parent="1" source="triggers" target="agent"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="e9" value="corrected timeline" style="endArrow=classic;html=1;fontSize=10;" edge="1" parent="1" source="agent" target="alerts"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="e10" style="endArrow=classic;html=1;" edge="1" parent="1" source="alerts" target="outputs"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="e11" style="endArrow=classic;html=1;edgeStyle=orthogonalEdgeStyle;" edge="1" parent="1" source="video" target="scene"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="e12" value="bed / seats" style="endArrow=classic;html=1;edgeStyle=orthogonalEdgeStyle;fontSize=10;" edge="1" parent="1" source="scene" target="rules"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="e13" style="endArrow=classic;startArrow=classic;html=1;" edge="1" parent="1" source="agent" target="tools"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="e14" value="ask_vlm" style="endArrow=classic;startArrow=classic;html=1;fontSize=10;" edge="1" parent="1" source="tools" target="gemini"><mxGeometry relative="1" as="geometry" /></mxCell>
      </root>
    </mxGraphModel>
  </diagram>
</mxfile>
