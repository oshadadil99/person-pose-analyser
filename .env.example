# Copy to .env and fill in. .env is gitignored.

# Vertex AI (vlm.provider: vertex)
# Path to a service-account key with the Vertex AI User role. Keep it in secrets/.
GOOGLE_APPLICATION_CREDENTIALS=secrets/your-service-account-key.json
GOOGLE_CLOUD_PROJECT=your-gcp-project-id
GOOGLE_CLOUD_LOCATION=global

# AI Studio (only needed for vlm.provider: aistudio)
GEMINI_API_KEY=
