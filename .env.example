# Copy to .env and fill in. .env is gitignored.
# Only needed for the Gemini (VLM) step. With --vlm none nothing here is used.

# Option 1: Gemini API key from Google AI Studio (vlm.provider: aistudio)
GEMINI_API_KEY=

# Option 2: Vertex AI on a GCP project (vlm.provider: vertex)
# Path to a service-account key with the Vertex AI User role. Keep it in secrets/.
GOOGLE_APPLICATION_CREDENTIALS=secrets/your-service-account-key.json
GOOGLE_CLOUD_PROJECT=your-gcp-project-id
GOOGLE_CLOUD_LOCATION=global
